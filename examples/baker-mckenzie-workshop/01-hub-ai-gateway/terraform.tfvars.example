# =====================================================================
# STACK A - Hub AI Gateway : example
# Deploy ONCE into the hub subscription. Then add each sandbox to
# registered_sandboxes (from Stack B outputs) and re-apply.
# =====================================================================

location            = "centralus"
resource_group_name = "rg-ai-gateway-hub"
apim_name           = "apim-bmk-ai-gateway"   # must be globally unique
apim_sku            = "StandardV2_1"          # fallback: "Developer_1" if v2 VNet integration errors

publisher_name  = "Baker McKenzie AI Platform"
publisher_email = "aiplatform@bakermckenzie.com"

# Hub VNet the gateway integrates into and the sandboxes peer to.
hub_vnet_resource_id       = "/subscriptions/<hub-sub-id>/resourceGroups/<hub-rg>/providers/Microsoft.Network/virtualNetworks/<hub-vnet>"
apim_subnet_address_prefix = "10.0.250.0/27"  # must be inside the hub VNet and unused

# Hub Log Analytics workspace - per-team token metrics land here for showback.
log_analytics_workspace_id = "/subscriptions/<hub-sub-id>/resourceGroups/<hub-rg>/providers/Microsoft.OperationalInsights/workspaces/<hub-law>"

# Start empty for the first APIM deploy. After a sandbox (Stack B) is up, paste its
# `register_in_stack_a` output here and re-apply to wire it behind the gateway.
registered_sandboxes = {
  # "applied-ai" = {
  #   display_name        = "applied-ai / contract-analysis"
  #   foundry_openai_url  = "https://<foundry-account>.openai.azure.com/"
  #   foundry_resource_id = "/subscriptions/.../providers/Microsoft.CognitiveServices/accounts/<foundry-account>"
  #   monthly_token_limit = 200000
  # }
}
